<div class="ltag-roadlio">
  <iframe
    src="<%= url %>"
    title="Roadlio"
    width="100%"
    height="400"
    loading="lazy"
    style="border: 0;"
    data-roadlio-iframe>
  </iframe>
</div>
<script>
  (() => {
    const iframe = document.currentScript.previousElementSibling.querySelector("iframe");
    const targetOrigin = new URL(iframe.src).origin;
    const hideHeader = true;

    const settings = () => ({
      darkMode: document.body.classList.contains("dark-theme"),
      hideHeader,
    });

    const sendSettings = () => {
      const currentSettings = settings();
      iframe.contentWindow?.postMessage({
        type: "roadlio:settings",
        ...currentSettings,
      }, targetOrigin);
    };

    const setInitialSettings = () => {
      const darkMode = document.body.classList.contains("dark-theme");
      const targetUrl = new URL(iframe.src);
      targetUrl.searchParams.set("darkMode", darkMode);
      targetUrl.searchParams.set("hideHeader", hideHeader);
      iframe.src = targetUrl.toString();
    };

    const resizeIframe = (event) => {
      if (event.origin !== targetOrigin || event.source !== iframe.contentWindow) return;
      if (event.data?.type !== "roadlio:resize") return;

      const height = Number(event.data.height);
      if (Number.isFinite(height) && height > 0) iframe.style.height = `${height}px`;
    };

    window.addEventListener("message", resizeIframe);
  iframe.addEventListener("load", sendSettings);
  setInitialSettings();

    new MutationObserver(sendSettings).observe(document.body, {
      attributes: true,
      attributeFilter: ["class"],
    });
  })();
</script>