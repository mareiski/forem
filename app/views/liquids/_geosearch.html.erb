<div class="ltag-geosearch">
  <% if results.empty? %>
    <p class="ltag-geosearch__empty">In diesem Umkreis wurden keine Artikel gefunden.</p>
  <% else %>
    <% results.each do |result| %>
        <%= render partial: "articles/single_story", locals: { story: result[:article], featured: false } %>
    <% end %>
  <% end %>
</div>